    x.globalAlpha = .6; x.beginPath(); x.moveTo(X(0), 0); x.lineTo(X(0), H); x.moveTo(0, Y(0)); x.lineTo(W, Y(0)); x.stroke(); x.globalAlpha = 1;
    if (!fn) return;
    x.strokeStyle = '#1565c0'; x.lineWidth = 2; x.beginPath(); let pen = false, py = 0;
    for (let i = 0; i <= W; i++) {
      const v = cx + (i - W / 2) / sc; let y; try { y = fn(v); } catch (e) { y = NaN; }
