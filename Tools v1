    const airUrl = `https://air-quality-api.open-meteo.com/v1/air-quality?${base}&hourly=us_aqi&forecast_hours=24`;
    try {
      const [forecast, airResult] = await Promise.all([
        requestJson(forecastUrl, 'Weather forecast'),
        requestJson(airUrl, 'Air-quality forecast').then(data => ({ data, error: null })).catch(error => ({ data: null, error }))
      ]);
      if (myRequest !== requestNumber) return;
      const H = forecast?.hourly;
      const required = ['time', 'temperature_2m', 'precipitation_probability', 'wind_speed_10m'];
      if (!H || required.some(key => !Array.isArray(H[key]) || !H[key].length)) {
        throw new Error('The weather service did not return the hourly data needed for this forecast.');
      }
      const count = H.time.length;
      if (required.slice(1).some(key => H[key].length < count)) throw new Error('The weather service returned incomplete hourly data. Please try again.');
      const AQ = airResult.data?.hourly?.us_aqi;
      const hasAQ = Array.isArray(AQ) && AQ.length > 0;
      const get = (key, i, fallback = null) => Array.isArray(H[key]) && H[key][i] != null ? H[key][i] : fallback;
      const rows = H.time.map((time, i) => {
        const temp = get('temperature_2m', i), feels = get('apparent_temperature', i, temp);
        const rainChance = get('precipitation_probability', i, 0), rain = get('precipitation', i, 0);
        const wind = get('wind_speed_10m', i, 0), gust = get('wind_gusts_10m', i, wind);
        const snow = get('snowfall', i, 0), code = get('weather_code', i, null), aqi = hasAQ ? (AQ[i] ?? null) : null;
        let score = 100;
        score -= Math.min(35, Math.abs(feels - 18) * 1.35);
        score -= Math.min(35, rainChance * 0.45);
        score -= Math.min(20, Math.max(0, wind - 12) * 0.8);
        if (aqi != null) score -= Math.min(20, Math.max(0, aqi - 50) * 0.2);
        return { time, temp, feels, rainChance, rain, wind, gust, snow, code, aqi, score: Math.max(0, Math.round(score)) };
      });
      const best = [...rows].sort((a, b) => b.score - a.score)[0];
      const totalSnow = rows.reduce((sum, row) => sum + (Number(row.snow) || 0), 0);
      const warnings = [];
      if (rows.some(r => r.rainChance >= 60)) warnings.push('Rain is likely during at least one forecast hour.');
      if (rows.some(r => r.wind >= 40 || r.gust >= 60)) warnings.push('Strong wind is forecast during at least one hour.');
      if (rows.some(r => r.snow >= 1)) warnings.push('Snowfall is forecast during at least one hour.');
      if (hasAQ && rows.some(r => r.aqi >= 100)) warnings.push('Air quality may be unhealthy for sensitive groups or worse during at least one hour.');

      const fmt = value => value == null || !Number.isFinite(Number(value)) ? '—' : Number(value).toFixed(1);
      const hourLabel = value => {
        const parts = String(value).split('T');
        if (parts.length < 2) return String(value);
        const dateParts = parts[0].split('-').map(Number);
        const weekday = dateParts.length === 3 && dateParts.every(Number.isFinite)
          ? new Date(Date.UTC(dateParts[0], dateParts[1] - 1, dateParts[2])).toLocaleDateString('en-US', { weekday: 'short', timeZone: 'UTC' })
          : '';
        return `${weekday} ${parts[1].slice(0, 5)}`.trim();
      };
      const tone = score => score >= 70 ? 'var(--ok)' : score >= 40 ? '#ef6c00' : 'var(--bad)';
      const alertHtml = warnings.length
        ? `<div class="card"><b>Forecast heads-up</b><ul>${warnings.map(item => `<li>${esc(item)}</li>`).join('')}</ul></div>`
        : '<div class="card">No notable rain, wind, snow, or air-quality warnings were found in the returned hours.</div>';
      const rowsHtml = rows.map(r => {
        const [description, icon] = weatherText(r.code);
        return `<tr><td>${esc(hourLabel(r.time))}</td><td>${icon} ${esc(description)}</td><td>${fmt(r.temp)}°</td><td>${fmt(r.feels)}°</td><td>${fmt(r.rainChance)}%</td><td>${fmt(r.wind)}</td><td>${fmt(r.snow)}</td><td>${r.aqi == null ? '—' : Math.round(r.aqi)}</td><td style="color:${tone(r.score)};font-weight:700">${r.score}/100</td></tr>`;
      }).join('');
      const timezone = forecast.timezone ? ` · ${esc(forecast.timezone)}` : '';
      output.innerHTML = `
        <div class="card">
          <div class="muted">24-hour forecast for</div>
          <h3 style="margin:4px 0 12px">${esc(name)}${timezone}</h3>
          <div class="row" style="align-items:stretch">
            <div class="keyboard-stat" style="flex:1"><span class="muted">Best outdoor hour</span><b>${esc(hourLabel(best.time))}</b><span>${best.score}/100 suitability estimate</span></div>
            <div class="keyboard-stat" style="flex:1"><span class="muted">Expected snowfall</span><b>${fmt(totalSnow)} cm</b><span>Across returned hours</span></div>
            <div class="keyboard-stat" style="flex:1"><span class="muted">Air quality</span><b>${hasAQ ? Math.round(rows.find(r => r.aqi != null)?.aqi ?? 0) : '—'}</b><span>${hasAQ ? 'US AQI, first returned hour' : 'Feed unavailable'}</span></div>
          </div>
          <p class="muted">Outdoor suitability is a simple estimate based on temperature, precipitation, wind, and available air-quality data. It is not an official safety rating.</p>
        </div>
        ${alertHtml}
        <div class="mine-wrap" style="overflow-x:auto"><table><thead><tr><th>Time</th><th>Conditions</th><th>Temp</th><th>Feels</th><th>Rain chance</th><th>Wind km/h</th><th>Snow cm</th><th>US AQI</th><th>Outdoor score</th></tr></thead><tbody>${rowsHtml}</tbody></table></div>
        ${airResult.error ? `<p class="muted">Air-quality data could not be loaded (${esc(airResult.error.message)}). The weather forecast is still available; AQI is shown as — rather than guessed.</p>` : ''}`;
      status.textContent = `Forecast loaded for ${name}.`;
    } catch (error) {
      if (myRequest !== requestNumber) return;
      status.textContent = `Could not load weather: ${error?.message || 'Unknown error'}`;
      output.innerHTML = '<p class="muted">Check the place or coordinates and your internet connection, then try again.</p>';
    } finally {
      if (myRequest === requestNumber) setBusy(false);
    }
  };

  const resolvePlace = async query => {
    if (busy) return;
    const myRequest = ++requestNumber;
    setBusy(true);
    status.textContent = `Finding ${query}…`;
    output.textContent = '';
    try {
      const data = await requestJson(`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(query)}&count=8&language=en&format=json`, 'Place search');
      if (myRequest !== requestNumber) return;
      const results = Array.isArray(data.results) ? data.results : [];
      if (!results.length) throw new Error(`No places matched “${query}”. Try adding a province, state, or country.`);
      if (results.length === 1) {
        setBusy(false);
        await loadForecast(Number(results[0].latitude), Number(results[0].longitude), niceLocation(results[0]));
        return;
      }
      setBusy(false);
      status.textContent = 'Choose the correct place from the matches:';
      output.innerHTML = `<div class="card"><label for="weatherMatches"><b>Matching places</b></label><div class="row"><select id="weatherMatches" style="flex:1;min-width:220px">${results.map((p, i) => `<option value="${i}">${esc(niceLocation(p))}</option>`).join('')}</select><button id="weatherUseMatch" type="button">Get forecast</button></div></div>`;
      $('#weatherUseMatch', el).onclick = () => {
        const place = results[Number($('#weatherMatches', el).value)];
        if (place) loadForecast(Number(place.latitude), Number(place.longitude), niceLocation(place));
      };
    } catch (error) {
      if (myRequest !== requestNumber) return;
      status.textContent = `Could not find that place: ${error?.message || 'Unknown error'}`;
    } finally {
      if (myRequest === requestNumber) setBusy(false);
    }
  };

  placeForm.onsubmit = event => {
    event.preventDefault();
    const query = placeInput.value.trim();
    if (!query) { status.textContent = 'Type a city or place first.'; placeInput.focus(); return; }
    resolvePlace(query);
  };
  coordsBtn.onclick = () => {
    const latText = $('#weatherLat', el).value.trim(), lonText = $('#weatherLon', el).value.trim();
    if (!latText || !lonText) { status.textContent = 'Enter both latitude and longitude.'; return; }
    const lat = Number(latText), lon = Number(lonText);
    loadForecast(lat, lon, `Coordinates ${latText}, ${lonText}`);
  };
  locateBtn.onclick = () => {
    if (busy) return;
    if (!navigator.geolocation) { status.textContent = 'Location is not available in this browser. Search for a city or enter coordinates instead.'; return; }
    setBusy(true); status.textContent = 'Requesting your location…';
    navigator.geolocation.getCurrentPosition(position => {
      setBusy(false);
      loadForecast(position.coords.latitude, position.coords.longitude, 'Your current location');
    }, error => {
      setBusy(false);
      const reason = error.code === 1 ? 'Location permission was denied.' : error.code === 2 ? 'Your location could not be determined.' : 'The location request timed out.';
      status.textContent = `${reason} Search for a city or enter coordinates instead.`;
    }, { enableHighAccuracy: false, timeout: 12000, maximumAge: 300000 });
  };
}

