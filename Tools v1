}

function weeks(el) {
  el.innerHTML = '<div class="row"><label>Birth date <input type="date" id="d"></label><label>Years shown <input type="number" id="y" value="90" min="1" max="110" style="width:70px"></label></div><canvas id="cv" style="width:100%;max-width:560px"></canvas><div id="m" class="big" style="font-size:18px"></div><p class="muted">Each square is one week. Your birth date stays in this browser only.</p>';
  const d = $('#d', el); d.value = store.get('bday', '');
  const draw = () => {
    const cv = $('#cv', el), Y = Math.min(110, +$('#y', el).value || 90), S = 10; cv.width = 52 * S; cv.height = Y * S;
    const x = cv.getContext('2d'), b = d.value ? new Date(d.value + 'T00:00') : null, lived = b ? Math.max(0, Math.floor((Date.now() - b) / 6048e5)) : 0, fg = getComputedStyle(document.body).color;
    for (let k = 0; k < 52 * Y; k++) {
      const px = (k % 52) * S, py = (k / 52 | 0) * S;
      if (k < lived) { x.fillStyle = '#1565c0'; x.fillRect(px + 1, py + 1, S - 2, S - 2); }
      else { x.strokeStyle = fg; x.globalAlpha = .3; x.strokeRect(px + 1.5, py + 1.5, S - 3, S - 3); x.globalAlpha = 1; }
    }
    $('#m', el).textContent = b ? `${lived.toLocaleString()} weeks lived · about ${Math.max(0, 52 * Y - lived).toLocaleString()} left of ${52 * Y} (${Math.min(100, lived / (52 * Y) * 100).toFixed(1)}%)` : 'Pick your birth date';
    store.set('bday', d.value);
  };
  el.oninput = draw; draw();
}

