function graph(el) {
  el.innerHTML = '<div class="row"><span>y =</span><input id="e" value="sin(x)*x" style="flex:1"></div><canvas id="cv" width="640" height="420" style="width:100%;max-width:640px;border:1px solid var(--line);background:var(--card);touch-action:none"></canvas><p class="muted" id="m">Drag to pan, scroll to zoom. Functions: sin cos tan asin acos atan abs sqrt log exp floor ceil pow min max. Constants: pi, e. Use ^ for powers and * for multiply.</p>';
  const cv = $('#cv', el), x = cv.getContext('2d'); let cx = 0, cy = 0, sc = 40, fn = null;
  const FUNCS = { sin: Math.sin, cos: Math.cos, tan: Math.tan, asin: Math.asin, acos: Math.acos, atan: Math.atan, abs: Math.abs, sqrt: Math.sqrt, log: Math.log, exp: Math.exp, floor: Math.floor, ceil: Math.ceil, pow: Math.pow, min: Math.min, max: Math.max };
  const tokenize = source => {
    const tokens = [], re = /\s*(?:(?:\d+(?:\.\d*)?|\.\d+)(?:e[+-]?\d+)?|[a-zA-Z_]\w*|[+\-*/%^(),])/iy;
    let at = 0;
    while (at < source.length) {
      if (!source.slice(at).trim()) break;
      re.lastIndex = at; const m = re.exec(source);
      if (!m) throw new Error(`Unexpected character near "${source.slice(at, at + 8)}"`);
      tokens.push(m[0].trim()); at = re.lastIndex;
    }
    return tokens;
  };
  const compile = source => {
    const tokens = tokenize(source); let at = 0;
    const peek = () => tokens[at];
    const expression = min => {
      let left = primary();
      const priority = { '+': 1, '-': 1, '*': 2, '/': 2, '%': 2, '^': 4 };
      while (priority[peek()] !== undefined && priority[peek()] >= min) {
        const op = tokens[at++], p = priority[op], right = expression(op === '^' ? p : p + 1), before = left;
        left = value => { const a = before(value), b = right(value); return op === '+' ? a + b : op === '-' ? a - b : op === '*' ? a * b : op === '/' ? a / b : op === '%' ? a % b : Math.pow(a, b); };
      }
      return left;
    };
    const primary = () => {
      const token = tokens[at++];
      if (token === undefined) throw new Error('Expression is incomplete.');
      if (token === '+' || token === '-') { const value = expression(3); return xValue => token === '-' ? -value(xValue) : value(xValue); }
      if (token === '(') { const value = expression(0); if (peek() !== ')') throw new Error('Missing closing parenthesis.'); at++; return value; }
      if (/^(?:\d+(?:\.\d*)?|\.\d+)(?:e[+-]?\d+)?$/i.test(token)) { const n = Number(token); return () => n; }
      if (/^[a-zA-Z_]\w*$/.test(token)) {
        if (token === 'x') return xValue => xValue;
        if (token === 'pi') return () => Math.PI;
        if (token === 'e') return () => Math.E;
        if (!Object.prototype.hasOwnProperty.call(FUNCS, token) || peek() !== '(') throw new Error(`Unknown name: ${token}`);
        at++; const args = [];
        if (peek() !== ')') { while (true) { args.push(expression(0)); if (peek() !== ',') break; at++; } }
        if (peek() !== ')') throw new Error(`Missing ) after ${token}.`);
        at++;
        const expected = token === 'pow' ? 2 : (token === 'min' || token === 'max' ? null : 1);
        if ((expected !== null && args.length !== expected) || (expected === null && args.length < 1)) throw new Error(`${token}() has the wrong number of arguments.`);
        return xValue => FUNCS[token](...args.map(arg => arg(xValue)));
      }
      throw new Error(`Unexpected token: ${token}`);
    };
    if (!tokens.length) throw new Error('Enter a function first.');
    const result = expression(0);
    if (at !== tokens.length) throw new Error(`Unexpected token: ${tokens[at]}`);
    return result;
  };
  const draw = () => {
    const W = cv.width, H = cv.height, fg = getComputedStyle(document.body).color; x.clearRect(0, 0, W, H);
    const X = v => W / 2 + (v - cx) * sc, Y = v => H / 2 - (v - cy) * sc, st = [.1, .5, 1, 2, 5, 10, 50, 100].find(s => s * sc >= 40) || 100;
    x.strokeStyle = fg; x.globalAlpha = .12; x.lineWidth = 1;
    for (let g = Math.ceil((cx - W / 2 / sc) / st) * st; g < cx + W / 2 / sc; g += st) { x.beginPath(); x.moveTo(X(g), 0); x.lineTo(X(g), H); x.stroke(); }
