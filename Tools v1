// ================= ROUTER & HOME =================
let Q = '', CAT = 'All';

function home(app) {
  const cats = ['All', ...new Set(T.map(t => t.c))];
  app.innerHTML = `<input id="q" type="search" placeholder="Search tools… (press / to focus)" style="width:100%;font-size:16px" value="${esc(Q)}"><div class="chips" id="ch"></div><div id="g" class="grid"></div><div id="n" class="muted" style="margin:14px 0"></div><details class="card"><summary><b>Ideas not built yet</b> (${SOON.length})</summary><div class="chips" style="margin-top:10px">${SOON.map(s => `<span class="chip" style="opacity:.7">${esc(s)}</span>`).join('')}</div></details>`;
  const draw = () => {
    $('#ch', app).innerHTML = cats.map(c => `<button class="chip ${c === CAT ? 'on' : ''}" data-c="${esc(c)}">${esc(c)}</button>`).join('');
    const q = Q.toLowerCase(), L = T.filter(t => (CAT === 'All' || t.c === CAT) && (t.n + ' ' + t.d + ' ' + t.c).toLowerCase().includes(q));
    $('#g', app).innerHTML = L.map(t => `<a class="tile" href="${t.href || '#/' + t.id}" ${t.href ? 'target="_blank" rel="noopener"' : ''}><div class="i">${t.i}</div><b>${esc(t.n)}</b><span>${esc(t.d)}</span></a>`).join('');
    $('#n', app).textContent = L.length ? `${L.length} tool${L.length === 1 ? '' : 's'}` : 'No tools match that search.';
  };
  $('#q', app).oninput = e => { Q = e.target.value; draw(); };
  $('#ch', app).onclick = e => { const button=e.target.closest('button[data-c]'); if(button){CAT=button.dataset.c;draw();} };
  on(document, 'keydown', e => { if (e.key === '/' && !/INPUT|TEXTAREA|SELECT/.test(e.target.tagName)) { e.preventDefault(); $('#q', app).focus(); } });
  draw();
}

function route() {
  cleanups.splice(0).forEach(f => { try { f(); } catch (e) {} });
  document.title = 'My Tools';
  const id = location.hash.replace(/^#\/?/, ''), t = T.find(x => x.id === id && x.f), app = $('#app');
  app.innerHTML = '';
  $('#sub').textContent = `${T.length} tools in one place. Click one to open it.`;
  if (!t) { home(app); return; }
  const head = document.createElement('div');
  head.innerHTML = `<a class="back" href="#/">← All tools</a><h2>${t.i} ${esc(t.n)}</h2>`;
  app.appendChild(head);
  const el = document.createElement('div'); app.appendChild(el);
  try { t.f(el); } catch (e) { el.innerHTML = '<div class="card">Something went wrong: ' + esc(e.message) + '</div>'; }
  scrollTo(0, 0);
}
addEventListener('hashchange', route);
route();
</script>
</body>
</html>
