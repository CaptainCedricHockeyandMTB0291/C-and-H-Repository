  let h = '', inl = false;
  for (const raw of esc(s).split('\n')) {
    let m;
    if (m = raw.match(/^(#{1,3}) (.*)/)) { if (inl) { h += '</ul>'; inl = false; } h += `<h${m[1].length}>${il(m[2])}</h${m[1].length}>`; }
    else if (m = raw.match(/^[-*] (.*)/)) { if (!inl) { h += '<ul>'; inl = true; } h += `<li>${il(m[1])}</li>`; }
    else { if (inl) { h += '</ul>'; inl = false; } h += raw.trim() ? `<p>${il(raw)}</p>` : ''; }
  }
  return h + (inl ? '</ul>' : '');
}
