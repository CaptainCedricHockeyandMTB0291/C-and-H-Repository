  let M = null;
  const show = () => { $('#o', el).innerHTML = '<p class="muted">Pass the device around. Tap your name to see who you got, then tap Hide.</p><div class="row">' + M.map((m, i) => `<button class="alt" data-i="${i}">${esc(m[0])}</button>`).join('') + '</div><div id="r" class="big" style="font-size:22px"></div>'; };
