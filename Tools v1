<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>My Tools</title>
<style>
  :root { --bg:#f4f4f0; --fg:#1a1a1a; --card:#fff; --line:#e3e3dc; --blue:#1565c0; --ok:#2e7d32; --bad:#d32f2f; color-scheme: light dark; }
  @media (prefers-color-scheme: dark) { :root { --bg:#121212; --fg:#eee; --card:#1e1e1e; --line:#333; --blue:#64b5f6; --ok:#66bb6a; --bad:#ef5350; } }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--bg); color:var(--fg); font-family:system-ui,sans-serif; }
  .wrap { max-width:1000px; margin:0 auto; padding:20px; }
  h1 { margin:0 0 4px; } h2 { margin:8px 0 14px; }
  .sub, .muted { opacity:.7; font-size:13px; }
  input, select, textarea, button { font:inherit; font-size:14px; }
  input, select, textarea { padding:8px; border-radius:8px; border:1px solid var(--line); background:var(--card); color:var(--fg); min-width:0; }
  textarea { width:100%; min-height:120px; font-family:ui-monospace,monospace; }
  button { padding:9px 14px; border:none; border-radius:8px; background:var(--blue); color:#fff; font-weight:600; cursor:pointer; }
  button.alt { background:transparent; color:var(--fg); border:1px solid var(--line); }
  .row { display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin:8px 0; }
  .card { background:var(--card); border:1px solid var(--line); border-radius:12px; padding:14px; margin-bottom:12px; }
  .chips { display:flex; gap:6px; flex-wrap:wrap; margin:12px 0; }
  .chip { padding:6px 12px; border-radius:99px; border:1px solid var(--line); background:var(--card); color:var(--fg); font-weight:500; font-size:13px; }
  .chip.on { background:var(--blue); color:#fff; border-color:var(--blue); }
  .grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(210px,1fr)); gap:10px; }
  .tile { display:block; text-decoration:none; color:inherit; background:var(--card); border:1px solid var(--line); border-radius:12px; padding:14px; }
  .tile:hover { border-color:var(--blue); transform:translateY(-1px); }
  .tile .i { font-size:26px; } .tile b { display:block; margin:4px 0 2px; } .tile span { font-size:12px; opacity:.7; }
  a.back { color:var(--blue); text-decoration:none; font-weight:600; }
  .big { font-size:30px; font-weight:700; }
  .out { white-space:pre-wrap; word-break:break-word; font-family:ui-monospace,monospace; font-size:13px; }
  .b3 { display:grid; grid-template-columns:repeat(3,84px); gap:6px; margin:10px 0; }
  .b4 { display:grid; grid-template-columns:repeat(4,72px); gap:6px; margin:10px 0; }
  .cell { height:72px; font-size:28px; padding:0; background:var(--card); color:var(--fg); border:1px solid var(--line); display:flex; align-items:center; justify-content:center; border-radius:10px; font-weight:700; }
  .b3 .cell { height:84px; }
  .pad { display:flex; align-items:center; justify-content:center; min-height:200px; border:2px dashed var(--line); border-radius:12px; font-size:20px; font-weight:600; cursor:pointer; user-select:none; text-align:center; padding:20px; }
  table { border-collapse:collapse; width:100%; font-size:13px; }
  th, td { padding:5px 8px; text-align:left; border-bottom:1px solid var(--line); }
  mark { background:rgba(255,213,0,.5); color:inherit; }
  code { font-family:ui-monospace,monospace; }
  .mine-wrap { max-width:100%; overflow-x:auto; padding-bottom:6px; }
  .mine-board { display:grid; gap:3px; width:max-content; }
  .mine-cell { width:32px; height:32px; min-width:32px; padding:0; border-radius:5px; font-size:15px; background:#8b9baa; color:#111; border:1px solid #64748b; }
  .mine-cell.revealed { background:var(--card); border-color:var(--line); }
  .mine-cell.flagged { background:#dbeafe; }
  .mine-cell.n1 { color:#2563eb; } .mine-cell.n2 { color:#15803d; } .mine-cell.n3 { color:#dc2626; }
  .connect-board { display:grid; grid-template-columns:repeat(7,minmax(34px,54px)); gap:6px; width:max-content; max-width:100%; padding:10px; border-radius:14px; background:#2563eb; }
  .connect-cell { width:100%; aspect-ratio:1; min-width:0; padding:0; border-radius:50%; background:var(--card); border:2px solid rgba(0,0,0,.15); }
  .connect-cell.p1 { background:#ef4444; } .connect-cell.p2 { background:#facc15; }
  .connect-cell:disabled { cursor:default; opacity:1; }
  .connect-drops { display:grid; grid-template-columns:repeat(7,minmax(34px,54px)); gap:6px; width:max-content; margin:8px 0; }
  .connect-drops button { padding:7px 0; }
  .hangman-letters { display:grid; grid-template-columns:repeat(7,minmax(34px,1fr)); gap:6px; max-width:430px; }
  .hangman-letters button { padding:8px 2px; }
  .hangman-word { font-size:clamp(22px,5vw,34px); letter-spacing:.22em; font-weight:700; overflow-wrap:anywhere; }
  .keyboard-stage { padding:12px; border:2px solid var(--line); border-radius:12px; background:var(--bg); outline:none; }
  .keyboard-stage:focus-visible { border-color:var(--blue); box-shadow:0 0 0 3px color-mix(in srgb,var(--blue) 22%,transparent); }
  .keyboard-row { display:flex; gap:5px; margin:5px 0; }
  .keyboard-key { flex:1 1 0; min-width:0; min-height:42px; padding:5px 3px; border:1px solid var(--line); border-radius:7px; background:var(--card); color:var(--fg); display:flex; justify-content:center; align-items:center; font-size:11px; user-select:none; text-align:center; }
  .keyboard-key.wide { flex:1.7 1 0; } .keyboard-key.wider { flex:2.4 1 0; } .keyboard-key.space { flex:5 1 0; }
  .keyboard-key.down { background:var(--blue); color:white; border-color:var(--blue); transform:translateY(1px); }
  .keyboard-stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(130px,1fr)); gap:8px; margin:12px 0; }
  .keyboard-stat { padding:10px; border:1px solid var(--line); border-radius:9px; background:var(--card); }
  .keyboard-stat b { display:block; font-size:22px; }
  .keyboard-log { max-height:180px; overflow:auto; font:12px/1.6 ui-monospace,monospace; white-space:pre-wrap; }
  @media (max-width:520px) { .wrap { padding:14px; } .b3 { grid-template-columns:repeat(3,minmax(0,1fr)); } .b4 { grid-template-columns:repeat(4,minmax(0,1fr)); } .cell { height:auto; aspect-ratio:1; } .b3 .cell { height:auto; } .mine-cell { width:29px; height:29px; min-width:29px; } }
</style>
</head>
<body>
<div class="wrap">
  <h1>My Tools</h1>
  <div class="sub" id="sub"></div>
  <div id="app"></div>
</div>

<script>
// ================= helpers =================
const $ = (s, r = document) => r.querySelector(s);
const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const store = {
  get(k, d) { try { const v = localStorage.getItem('hub.' + k); return v === null ? d : JSON.parse(v); } catch (e) { return d; } },
  set(k, v) { try { localStorage.setItem('hub.' + k, JSON.stringify(v)); } catch (e) {} }
};
const cleanups = [];
const on = (t, e, f, o) => { t.addEventListener(e, f, o); cleanups.push(() => t.removeEventListener(e, f, o)); };
const every = (f, ms) => { const i = setInterval(f, ms); cleanups.push(() => clearInterval(i)); return i; };
const later = (f, ms) => {
  let i;
  const cleanup = () => clearTimeout(i);
  i = setTimeout(() => { const at = cleanups.indexOf(cleanup); if (at !== -1) cleanups.splice(at, 1); f(); }, ms);
  cleanups.push(cleanup);
  return i;
};
const shuf = a => { a = [...a]; for (let i = a.length - 1; i > 0; i--) { const j = Math.random() * (i + 1) | 0; [a[i], a[j]] = [a[j], a[i]]; } return a; };
let AC;
const ac = () => {
  const Ctx = window.AudioContext || window.webkitAudioContext;
  if (!Ctx) throw new Error('Web Audio is not supported in this browser.');
  AC = AC || new Ctx();
  if (AC.state === 'suspended') AC.resume().catch(() => {});
  return AC;
};
const beep = (f = 880, ms = 150) => { try { const c = ac(), o = c.createOscillator(), g = c.createGain(), t = c.currentTime; o.frequency.value = f; g.gain.setValueAtTime(.2, t); g.gain.exponentialRampToValueAtTime(.001, t + ms / 1000); o.connect(g); g.connect(c.destination); o.start(t); o.stop(t + ms / 1000 + .02); } catch (e) {} };
const copy = async t => {
  const value = String(t ?? '');
  try {
    if (navigator.clipboard && navigator.clipboard.writeText) { await navigator.clipboard.writeText(value); return true; }
    const box = document.createElement('textarea'); box.value = value; box.style.position = 'fixed'; box.style.opacity = '0';
    document.body.appendChild(box); box.select(); const ok = document.execCommand('copy'); box.remove(); return ok;
  } catch (e) { return false; }
};

// ================= GAMES =================
function ttt(el) {
  el.innerHTML = '<div class="b3" id="b"></div><p id="m" class="big"></p><button id="r">New game</button><p class="muted">You are X. The computer never loses.</p>';
  let b, over;
  const W = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];
  const win = s => { for (const [a, c, d] of W) if (s[a] && s[a] === s[c] && s[a] === s[d]) return s[a]; return s.includes('') ? null : 'T'; };
  const mm = (s, p) => { const w = win(s); if (w) return w === 'O' ? 1 : w === 'X' ? -1 : 0; let best = p === 'O' ? -2 : 2; for (let i = 0; i < 9; i++) if (!s[i]) { s[i] = p; const v = mm(s, p === 'O' ? 'X' : 'O'); s[i] = ''; best = p === 'O' ? Math.max(best, v) : Math.min(best, v); } return best; };
  const draw = () => { $('#b', el).innerHTML = b.map((v, i) => `<button class="cell" data-i="${i}">${v}</button>`).join(''); const w = win(b); over = !!w; $('#m', el).textContent = w === 'T' ? 'Draw' : w ? (w === 'X' ? 'You win!' : 'Computer wins') : ''; };
  const reset = () => { b = Array(9).fill(''); over = false; draw(); };
  $('#b', el).onclick = e => {
    const button = e.target.closest('button[data-i]'); if (!button) return; const i = button.dataset.i; if (i === undefined || over || b[i]) return;
    b[i] = 'X';
    if (!win(b)) { let best = -2, mv; for (let j = 0; j < 9; j++) if (!b[j]) { b[j] = 'O'; const v = mm(b, 'X'); b[j] = ''; if (v > best) { best = v; mv = j; } } b[mv] = 'O'; }
    draw();
  };
  $('#r', el).onclick = reset; reset();
}

function memory(el) {
  const E = ['🍎','🚌','🌲','⭐','🎲','🐟','🚀','🎧']; let cards, open, lock, moves, found, hideTimer = null;
  el.innerHTML = '<div class="row"><span>Moves: <b id="mv">0</b></span><button id="r" class="alt">Restart</button></div><div class="b4" id="b"></div><p id="m" class="big"></p>';
  const draw = () => { $('#b', el).innerHTML = cards.map((c, i) => `<button class="cell" data-i="${i}">${c.s ? c.e : '?'}</button>`).join(''); $('#mv', el).textContent = moves; $('#m', el).textContent = found === 8 ? `Done in ${moves} moves!` : ''; };
  const start = () => { if (hideTimer !== null) { clearTimeout(hideTimer); hideTimer = null; } cards = shuf([...E, ...E]).map(e => ({ e, s: 0 })); open = []; moves = 0; found = 0; lock = false; draw(); };
  $('#b', el).onclick = e => {
    const button = e.target.closest('button[data-i]'); if (!button) return; const i = Number(button.dataset.i); if (!Number.isInteger(i) || !cards[i] || lock || cards[i].s) return;
    cards[i].s = 1; open.push(i);
    if (open.length === 2) {
      moves++; const [a, b] = open;
      if (cards[a].e === cards[b].e) { found++; open = []; }
      else { lock = true; hideTimer = later(() => { hideTimer = null; if (!cards[a] || !cards[b]) return; cards[a].s = cards[b].s = 0; open = []; lock = false; draw(); }, 700); }
    }
    draw();
  };
  $('#r', el).onclick = start; start();
}

function whack(el) {
  el.innerHTML = '<div class="row"><span>Score <b id="s">0</b></span><span>Time <b id="t">30</b></span><button id="go">Start</button></div><div class="b3" id="b"></div>';
  let sc = 0, tl = 30, pos = -1, run = false, started = false;
  const draw = () => { $('#b', el).innerHTML = Array.from({ length: 9 }, (_, i) => `<button class="cell" data-i="${i}">${i === pos ? '🐹' : ''}</button>`).join(''); };
  $('#b', el).onclick = e => { const button = e.target.closest('button[data-i]'); if (!button) return; const i = Number(button.dataset.i); if (run && i === pos) { sc++; pos = -1; $('#s', el).textContent = sc; draw(); } };
  $('#go', el).onclick = e => {
    if (run) { run = false; pos = -1; e.target.textContent = 'Resume'; draw(); return; }
    if (!started || tl <= 0) { sc = 0; tl = 30; started = true; $('#s', el).textContent = 0; $('#t', el).textContent = 30; }
    run = true; e.target.textContent = 'Pause'; draw();
  };
  every(() => { if (!run) return; pos = Math.random() * 9 | 0; draw(); }, 700);
  every(() => { if (!run) return; tl--; $('#t', el).textContent = tl; if (tl <= 0) { run = false; started = false; pos = -1; $('#go', el).textContent = 'Start'; draw(); } }, 1000);
  draw();
}

function reaction(el) {
  el.innerHTML = '<div id="pad" class="pad">Click to start</div><p id="m" class="big"></p>';
  const pad = $('#pad', el); let st = 'idle', t0, to, best = store.get('rt', null);
  const set = (t, bg) => { pad.textContent = t; pad.style.background = bg; pad.style.color = bg ? '#fff' : ''; };
  const msg = () => $('#m', el).textContent = best ? `Best: ${best} ms` : ''; msg();
  pad.onclick = () => {
    if (st === 'idle') { st = 'wait'; set('Wait for green…', '#c62828'); to = later(() => { st = 'go'; set('CLICK!', '#2e7d32'); t0 = performance.now(); }, 1000 + Math.random() * 3000); }
    else if (st === 'wait') { clearTimeout(to); st = 'idle'; set('Too soon! Click to retry', ''); }
    else { const d = Math.round(performance.now() - t0); st = 'idle'; set(d + ' ms. Click to go again', ''); if (!best || d < best) { best = d; store.set('rt', d); } msg(); }
  };
}

function g2048(el) {
  el.innerHTML = '<div class="row"><span>Score <b id="s">0</b></span><button id="r" class="alt">New game</button></div><div class="b4" id="b"></div><p class="muted">Arrow keys or swipe</p><p id="m" class="big"></p>';
  let g, sc, over = false; const N = 4;
  const add = () => { const e = []; g.forEach((v, i) => v || e.push(i)); if (e.length) g[e[Math.random() * e.length | 0]] = Math.random() < .9 ? 2 : 4; };
  const draw = () => { $('#b', el).innerHTML = g.map(v => `<div class="cell" style="${v ? `background:hsl(${40 - Math.log2(v) * 3},80%,${75 - Math.log2(v) * 3}%);color:#222` : ''}">${v || ''}</div>`).join(''); $('#s', el).textContent = sc; $('#m', el).textContent = over ? 'No moves left — game over!' : ''; };
  const canMove = () => { if (g.some(v => !v)) return true; for (let r = 0; r < N; r++) for (let c = 0; c < N; c++) { const i = r * N + c; if (c < N - 1 && g[i] === g[i + 1]) return true; if (r < N - 1 && g[i] === g[i + N]) return true; } return false; };
  const line = a => { a = a.filter(Boolean); for (let i = 0; i < a.length - 1; i++) if (a[i] === a[i + 1]) { a[i] *= 2; sc += a[i]; a.splice(i + 1, 1); } while (a.length < N) a.push(0); return a; };
  const move = d => {
    const o = g.join();
    for (let k = 0; k < N; k++) {
      const idx = [0, 1, 2, 3].map(j => d < 2 ? k * N + j : j * N + k);
      let a = idx.map(i => g[i]); if (d % 2) a.reverse(); a = line(a); if (d % 2) a.reverse();
      idx.forEach((i, j) => g[i] = a[j]);
    }
    if (g.join() !== o && !over) { add(); over = !canMove(); draw(); }
  };
  const start = () => { g = Array(16).fill(0); sc = 0; over = false; add(); add(); draw(); };
  on(document, 'keydown', e => {
    const active = document.activeElement, tag = active && active.tagName;
    if ((tag && /^(INPUT|TEXTAREA|SELECT)$/.test(tag)) || (active && active.isContentEditable)) return;
    const d = { ArrowLeft: 0, ArrowRight: 1, ArrowUp: 2, ArrowDown: 3 }[e.key];
    if (d !== undefined && location.hash.replace(/^#\/?/, '') === 'g2048') { e.preventDefault(); move(d); }
  });
  let t0 = null;
  on(el, 'touchstart', e => { if (e.touches && e.touches[0]) t0 = { x: e.touches[0].clientX, y: e.touches[0].clientY }; }, { passive: true });
  on(el, 'touchend', e => { if (!t0 || !e.changedTouches || !e.changedTouches[0]) return; const t = e.changedTouches[0], dx = t.clientX - t0.x, dy = t.clientY - t0.y; t0 = null; if (Math.max(Math.abs(dx), Math.abs(dy)) < 25) return; move(Math.abs(dx) > Math.abs(dy) ? (dx < 0 ? 0 : 1) : (dy < 0 ? 2 : 3)); }, { passive: true });
  $('#r', el).onclick = start; start();
}

function rps(el) {
  el.innerHTML = '<div class="row"><button data-m="0">✊ Rock</button><button data-m="1">✋ Paper</button><button data-m="2">✌️ Scissors</button></div><p id="m" class="big">Pick one</p><p id="s" class="muted"></p>';
  const hist = [], tr = {}; let w = 0, l = 0, d = 0; const N = ['Rock', 'Paper', 'Scissors'];
  el.onclick = e => {
    const button = e.target.closest('button[data-m]'); if (!button) return; const me = Number(button.dataset.m);
    const key = hist.slice(-2).join(), c = tr[key] || [0, 0, 0];
    let pred = c.indexOf(Math.max(...c)); if (hist.length < 2 || Math.max(...c) === 0) pred = Math.random() * 3 | 0;
    const ai = (pred + 1) % 3;
    if (hist.length >= 2) { tr[key] = c; c[me]++; }
    hist.push(me);
    const r = (me - ai + 3) % 3; r === 0 ? d++ : r === 1 ? w++ : l++;
    $('#m', el).textContent = `You ${N[me]} vs ${N[ai]}: ${r === 0 ? 'Draw' : r === 1 ? 'You win' : 'AI wins'}`;
    $('#s', el).textContent = `Wins ${w} · Losses ${l} · Draws ${d} · It learns your habits, so mix it up!`;
  };
}

function life(el) {
  el.innerHTML = '<div class="row"><button id="p">Play</button><button id="st" class="alt">Step</button><button id="rn" class="alt">Random</button><button id="c" class="alt">Clear</button></div><canvas id="cv" width="480" height="480" style="width:100%;max-width:480px;border:1px solid var(--line);background:var(--card);touch-action:none"></canvas><p class="muted">Click or drag to draw cells.</p>';
  const N = 48, S = 10, cv = $('#cv', el), x = cv.getContext('2d'); let g = Array.from({ length: N }, () => Array(N).fill(0)), play = false;
  const draw = () => { x.clearRect(0, 0, 480, 480); x.fillStyle = '#2e7d32'; g.forEach((r, i) => r.forEach((v, j) => v && x.fillRect(j * S + 1, i * S + 1, S - 2, S - 2))); };
  const step = () => { g = g.map((r, i) => r.map((v, j) => { let n = 0; for (let a = -1; a <= 1; a++) for (let b = -1; b <= 1; b++) if (a || b) n += g[(i + a + N) % N][(j + b + N) % N]; return n === 3 || (v && n === 2) ? 1 : 0; })); draw(); };
  const paint = e => { const r = cv.getBoundingClientRect(), j = (e.clientX - r.left) / r.width * N | 0, i = (e.clientY - r.top) / r.height * N | 0; if (g[i] && g[i][j] !== undefined) { g[i][j] = e.type === 'pointerdown' ? +!g[i][j] : 1; draw(); } };
  cv.onpointerdown = paint; cv.onpointermove = e => { if (e.buttons) paint(e); };
  $('#p', el).onclick = e => { play = !play; e.target.textContent = play ? 'Pause' : 'Play'; };
  $('#st', el).onclick = step;
  $('#rn', el).onclick = () => { g = g.map(r => r.map(() => Math.random() < .25 ? 1 : 0)); draw(); };
  $('#c', el).onclick = () => { g = g.map(r => r.map(() => 0)); draw(); };
  every(() => { if (play) step(); }, 120); draw();
}

function dice(el) {
  el.innerHTML = `<div class="row"><select id="n">${[1,2,3,4,5,6].map(i => `<option>${i}</option>`).join('')}</select><span>×  d</span><select id="s">${[4,6,8,10,12,20,100].map(i => `<option ${i == 6 ? 'selected' : ''}>${i}</option>`).join('')}</select><button id="r">Roll</button><button id="c" class="alt">Flip coin</button></div><div id="o" class="big">–</div><hr><div class="row"><input id="q" placeholder="Ask a yes/no question" style="flex:1"><button id="b">Ask the 8-ball</button></div><div id="a" class="big" style="font-size:22px"></div>`;
  $('#r', el).onclick = () => { const n = +$('#n', el).value, s = +$('#s', el).value, r = Array.from({ length: n }, () => 1 + Math.random() * s | 0); $('#o', el).textContent = r.join(' + ') + (n > 1 ? ' = ' + r.reduce((a, b) => a + b) : ''); };
  $('#c', el).onclick = () => $('#o', el).textContent = Math.random() < .5 ? 'Heads' : 'Tails';
  const A = ['It is certain.', 'Without a doubt.', 'Yes, definitely.', 'Most likely.', 'Ask again later.', 'Cannot predict now.', "Don't count on it.", 'My reply is no.', 'Very doubtful.', 'Signs point to yes.'];
  $('#b', el).onclick = () => $('#a', el).textContent = '🎱 ' + A[Math.random() * A.length | 0];
}

// ================= EXTRA GAMES =================
function connect4(el) {
  const ROWS = 6, COLS = 7;
  let board, player, over;
  el.innerHTML = '<div class="row"><b id="turn">Red goes first</b><button id="reset" class="alt">New game</button></div><div class="connect-drops" id="drops"></div><div class="connect-board" id="board" aria-label="Connect Four board"></div><p id="msg" class="muted">Two players, one keyboard or screen. Connect four to win.</p>';
  const directions = [[0,1],[1,0],[1,1],[1,-1]];
  const count = (r, c, dr, dc, p) => {
    let total = 0, y = r + dr, x = c + dc;
    while (y >= 0 && y < ROWS && x >= 0 && x < COLS && board[y][x] === p) { total++; y += dr; x += dc; }
    return total;
  };
  const draw = () => {
    $('#turn', el).textContent = over ? 'Game finished' : (player === 1 ? 'Red' : 'Yellow') + "'s turn";
    $('#drops', el).innerHTML = Array.from({length: COLS}, (_, c) => `<button data-col="${c}" aria-label="Drop in column ${c + 1}" ${over ? 'disabled' : ''}>▼</button>`).join('');
    $('#board', el).innerHTML = board.flatMap((row, r) => row.map((v, c) => `<button class="connect-cell ${v === 1 ? 'p1' : v === 2 ? 'p2' : ''}" data-col="${c}" aria-label="Row ${r + 1}, column ${c + 1}" disabled></button>`)).join('');
  };
  const reset = () => { board = Array.from({length: ROWS}, () => Array(COLS).fill(0)); player = 1; over = false; $('#msg', el).textContent = 'Two players, one keyboard or screen. Connect four to win.'; draw(); };
  $('#drops', el).onclick = e => {
    const button = e.target.closest('button[data-col]'); if (!button || over) return;
    const c = Number(button.dataset.col); if (!Number.isInteger(c) || c < 0 || c >= COLS) return;
    let r = ROWS - 1; while (r >= 0 && board[r][c]) r--; if (r < 0) return;
    board[r][c] = player;
    const won = directions.some(([dr, dc]) => 1 + count(r, c, dr, dc, player) + count(r, c, -dr, -dc, player) >= 4);
    if (won) { over = true; $('#msg', el).textContent = (player === 1 ? 'Red' : 'Yellow') + ' wins!'; }
    else if (board.every(row => row.every(Boolean))) { over = true; $('#msg', el).textContent = 'Draw — the board is full.'; }
    else player = player === 1 ? 2 : 1;
    draw();
  };
  $('#reset', el).onclick = reset; reset();
}

function minesweeper(el) {
  const LEVELS = { Beginner: [9, 9, 10], Intermediate: [16, 16, 40], Expert: [16, 30, 99] };
  let rows = 9, cols = 9, total = 10, cells = [], started = false, finished = false, flagMode = false, seconds = 0;
  el.innerHTML = '<div class="row"><label>Difficulty <select id="level"><option>Beginner</option><option>Intermediate</option><option>Expert</option></select></label><button id="new" class="alt">New game</button><button id="flag" class="alt">Flag mode: off</button></div><div class="row"><b id="flags">Flags: 0 / 10</b><span id="time" class="muted">Time: 0s</span></div><div class="mine-wrap"><div id="board" class="mine-board"></div></div><p id="msg" class="muted">Reveal a square. Your first square and its neighbors are always safe.</p>';
  every(() => { if (started && !finished) { seconds++; $('#time', el).textContent = `Time: ${seconds}s`; } }, 1000);
  const neighbors = i => {
    const r = Math.floor(i / cols), c = i % cols, out = [];
    for (let dr = -1; dr <= 1; dr++) for (let dc = -1; dc <= 1; dc++) {
      if (!dr && !dc) continue; const y = r + dr, x = c + dc;
      if (y >= 0 && y < rows && x >= 0 && x < cols) out.push(y * cols + x);
    }
    return out;
  };
  const draw = () => {
    const flags = cells.filter(c => c.flag).length;
    $('#flags', el).textContent = `Flags: ${flags} / ${total}`;
    $('#board', el).style.gridTemplateColumns = `repeat(${cols}, 32px)`;
    $('#board', el).innerHTML = cells.map((c, i) => {
      const text = c.flag ? '🚩' : !c.open ? '' : c.mine ? '💣' : c.count ? c.count : '';
      return `<button class="mine-cell ${c.open ? 'revealed' : ''} ${c.flag ? 'flagged' : ''} ${c.open && c.count ? 'n' + c.count : ''}" data-i="${i}" aria-label="${c.open ? (c.mine ? 'Mine' : c.count ? c.count + ' neighboring mines' : 'Empty') : c.flag ? 'Flagged' : 'Hidden'}">${text}</button>`;
    }).join('');
  };
  const makeBoard = () => {
    [rows, cols, total] = LEVELS[$('#level', el).value];
    cells = Array.from({length: rows * cols}, () => ({mine:false, count:0, open:false, flag:false}));
    started = false; finished = false; flagMode = false; seconds = 0;
    $('#flag', el).textContent = 'Flag mode: off'; $('#time', el).textContent = 'Time: 0s';
    $('#msg', el).textContent = 'Reveal a square. Your first square and its neighbors are always safe.'; draw();
  };
  const plant = first => {
    const safe = new Set([first, ...neighbors(first)]), available = cells.map((_, i) => i).filter(i => !safe.has(i));
    for (const i of shuf(available).slice(0, total)) cells[i].mine = true;
    cells.forEach((cell, i) => { if (!cell.mine) cell.count = neighbors(i).filter(j => cells[j].mine).length; });
  };
  const finish = won => {
    finished = true;
    if (won) { $('#msg', el).textContent = `You cleared the board in ${seconds}s!`; }
    else { cells.forEach(c => { if (c.mine) c.open = true; }); $('#msg', el).textContent = 'Boom! You hit a mine. Press New game to retry.'; }
    draw();
  };
  const reveal = start => {
    const first = cells[start]; if (!first || first.open || first.flag || finished) return;
    if (!started) { started = true; plant(start); }
    if (cells[start].mine) { finish(false); return; }
    const queue = [start], seen = new Set();
    while (queue.length) {
      const i = queue.pop(); if (seen.has(i)) continue; seen.add(i);
      const c = cells[i]; if (!c || c.open || c.flag || c.mine) continue;
      c.open = true;
      if (c.count === 0) for (const n of neighbors(i)) if (!cells[n].open && !cells[n].flag && !cells[n].mine) queue.push(n);
    }
    if (cells.filter(c => !c.mine && c.open).length === cells.length - total) finish(true); else draw();
  };
  const toggleFlag = i => { const c = cells[i]; if (!c || c.open || finished) return; c.flag = !c.flag; draw(); };
  $('#board', el).onclick = e => {
    const b = e.target.closest('button[data-i]'); if (!b) return; const i = Number(b.dataset.i);
    if (flagMode) toggleFlag(i); else reveal(i);
  };
  $('#board', el).oncontextmenu = e => { const b = e.target.closest('button[data-i]'); if (!b) return; e.preventDefault(); toggleFlag(Number(b.dataset.i)); };
  $('#flag', el).onclick = () => { flagMode = !flagMode; $('#flag', el).textContent = `Flag mode: ${flagMode ? 'on' : 'off'}`; };
  $('#new', el).onclick = makeBoard; $('#level', el).onchange = makeBoard;
  makeBoard();
}

function hangman(el) {
  const WORDS = ['JAVASCRIPT','KEYBOARD','GALAXY','PUZZLE','MOUNTAIN','COMPUTER','BROWSER','PIXEL','ROCKET','BICYCLE','ELEPHANT','THUNDER','GUITAR','VOLCANO','NOTEBOOK','DIAMOND'];
  let word = '', used = new Set(), mistakes = 0, over = false;
  el.innerHTML = '<div class="row"><b id="status">Guess the word</b><button id="again" class="alt">New word</button></div><div id="word" class="hangman-word" aria-live="polite"></div><p id="count" class="muted"></p><div id="letters" class="hangman-letters"></div><p class="muted">You have 6 incorrect guesses. Click a letter or use your keyboard.</p>';
  const draw = () => {
    $('#word', el).textContent = [...word].map(ch => used.has(ch) || over ? ch : '_').join(' ');
    $('#count', el).textContent = `Wrong guesses: ${mistakes} / 6 · Used: ${[...used].join(' ') || 'none'}`;
    $('#letters', el).innerHTML = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').map(ch => `<button class="alt" data-letter="${ch}" ${used.has(ch) || over ? 'disabled' : ''}>${ch}</button>`).join('');
  };
  const start = () => { word = WORDS[Math.random() * WORDS.length | 0]; used = new Set(); mistakes = 0; over = false; $('#status', el).textContent = 'Guess the word'; draw(); };
  const guess = ch => {
    if (over || !/^[A-Z]$/.test(ch) || used.has(ch)) return;
    used.add(ch); if (!word.includes(ch)) mistakes++;
    if ([...word].every(c => used.has(c))) { over = true; $('#status', el).textContent = 'You won!'; }
    else if (mistakes >= 6) { over = true; $('#status', el).textContent = `Game over — the word was ${word}.`; }
    draw();
  };
  $('#letters', el).onclick = e => { const b = e.target.closest('button[data-letter]'); if (b) guess(b.dataset.letter); };
  $('#again', el).onclick = start;
  on(document, 'keydown', e => { if (location.hash.replace(/^#\/?/, '') !== 'hangman') return; if (e.ctrlKey || e.altKey || e.metaKey || (e.target && /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName))) return; if (/^[a-z]$/i.test(e.key)) guess(e.key.toUpperCase()); });
  start();
}

